import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
import logging
from typing import Dict, Tuple, Optional
import warnings
warnings.filterwarnings('ignore')


class MLPricePredictor:
    """🤖 Machine Learning Price Movement Predictor"""
    
    def __init__(self):
        self.model = None
        self.scaler = StandardScaler()
        self.is_trained = False
        self.feature_importance = {}
        
    def prepare_features(self, stock_data: dict) -> Optional[np.ndarray]:
        """
        📊 Prepare feature vector from stock data
        
        Features include:
        - Technical indicators (RSI, MACD, Bollinger Bands)
        - Price momentum (5d, 20d, 50d changes)
        - Volume patterns
        - Fundamental ratios (P/E, P/B, ROE, etc.)
        - Market sentiment indicators
        """
        try:
            features = []
            
            # 1. Technical Indicators (20 features)
            features.extend([
                stock_data.get('real_rsi', 50),  # RSI
                stock_data.get('enhanced_rsi_14', 50),  # Alternative RSI
                stock_data.get('enhanced_macd', 0),  # MACD
                stock_data.get('enhanced_signal_line', 0),  # MACD Signal
                stock_data.get('enhanced_bb_position', 0.5),  # Bollinger Band position
                stock_data.get('enhanced_bb_width', 0),  # Bollinger Band width
                stock_data.get('enhanced_atr_14', 0),  # Average True Range
                stock_data.get('enhanced_adx', 0),  # ADX
                stock_data.get('enhanced_cci', 0),  # Commodity Channel Index
                stock_data.get('enhanced_stoch_k', 50),  # Stochastic K
                stock_data.get('enhanced_stoch_d', 50),  # Stochastic D
                stock_data.get('enhanced_williams_r', -50),  # Williams %R
                stock_data.get('enhanced_roc', 0),  # Rate of Change
                stock_data.get('enhanced_mfi', 50),  # Money Flow Index
                stock_data.get('enhanced_obv_trend', 0),  # On-Balance Volume trend
                stock_data.get('enhanced_vwap_distance', 0),  # Distance from VWAP
                stock_data.get('ma_20', 0),  # 20-day MA
                stock_data.get('ma_50', 0),  # 50-day MA
                stock_data.get('ma_200', 0),  # 200-day MA
                stock_data.get('enhanced_price_vs_ma20', 0),  # Price vs MA20
            ])
            
            # 2. Price Momentum (10 features)
            current_price = stock_data.get('current_price', 0)
            features.extend([
                stock_data.get('enhanced_price_change_1d', 0),
                stock_data.get('enhanced_price_change_5d', 0),
                stock_data.get('enhanced_price_change_20d', 0),
                stock_data.get('enhanced_price_change_50d', 0),
                stock_data.get('price_momentum_5d', 0),
                stock_data.get('price_momentum_20d', 0),
                stock_data.get('volatility_20d', 0),
                stock_data.get('volatility_6m', 0),
                stock_data.get('enhanced_high_low_range', 0),
                current_price / max(stock_data.get('52_week_high', current_price), 1),  # Distance from 52w high
            ])
            
            # 3. Volume Patterns (8 features)
            features.extend([
                stock_data.get('enhanced_volume_ratio', 1),
                stock_data.get('enhanced_volume_trend', 0),
                stock_data.get('enhanced_volume_volatility', 0),
                stock_data.get('volume_spike', 0),
                stock_data.get('avg_volume', 0),
                stock_data.get('volume_ma_ratio', 1),
                stock_data.get('enhanced_obv', 0),
                stock_data.get('enhanced_mfi', 50),
            ])
            
            # 4. Fundamental Metrics (15 features)
            features.extend([
                stock_data.get('pe_ratio', 15),
                stock_data.get('pb_ratio', 3),
                stock_data.get('debt_to_equity', 1),
                stock_data.get('current_ratio', 1.5),
                stock_data.get('roe', 15),
                stock_data.get('roa', 10),
                stock_data.get('profit_margin', 10),
                stock_data.get('operating_margin', 15),
                stock_data.get('revenue_growth', 10),
                stock_data.get('earnings_growth', 10),
                stock_data.get('dividend_yield', 2),
                stock_data.get('payout_ratio', 30),
                stock_data.get('book_value', 100),
                stock_data.get('enterprise_value', 0),
                stock_data.get('market_cap', 0) / 1e9,  # Market cap in billions
            ])
            
            # 5. Sentiment & Flow (7 features)
            features.extend([
                stock_data.get('institutional_sentiment_score', 50),
                stock_data.get('fii_activity_score', 50),
                stock_data.get('dii_activity_score', 50),
                stock_data.get('contrarian_technical_score', 50),
                stock_data.get('contrarian_momentum_score', 50),
                stock_data.get('momentum_score', 0),
                stock_data.get('breakout_score', 0),
            ])
            
            # 6. Multi-timeframe Analysis (5 features)
            features.extend([
                stock_data.get('mtf_daily_trend_score', 50),
                stock_data.get('mtf_weekly_trend_score', 50),
                stock_data.get('mtf_monthly_trend_score', 50),
                stock_data.get('mtf_agreement_score', 50),
                stock_data.get('overall_trend_strength', 50),
            ])
            
            # Total: 65 features
            features_array = np.array(features, dtype=float)
            
            # Handle NaN/Inf values
            features_array = np.nan_to_num(features_array, nan=0.0, posinf=1e6, neginf=-1e6)
            
            return features_array
            
        except Exception as e:
            logging.error(f"Error preparing features: {e}")
            return None
    
    def train_model(self, training_data: list, labels: list):
        """
        🎓 Train the ML model with historical data
        
        Args:
            training_data: List of feature vectors
            labels: List of labels (1=UP, 0=NEUTRAL, -1=DOWN)
        """
        try:
            if len(training_data) < 50:
                logging.warning("Insufficient training data for ML model")
                return False
            
            X = np.array(training_data)
            y = np.array(labels)
            
            # Scale features
            X_scaled = self.scaler.fit_transform(X)
            
            # Split data
            X_train, X_test, y_train, y_test = train_test_split(
                X_scaled, y, test_size=0.2, random_state=42
            )
            
            # Train Gradient Boosting Classifier (better for financial data)
            self.model = GradientBoostingClassifier(
                n_estimators=100,
                learning_rate=0.1,
                max_depth=5,
                random_state=42,
                verbose=0
            )
            
            self.model.fit(X_train, y_train)
            
            # Calculate accuracy
            train_accuracy = self.model.score(X_train, y_train)
            test_accuracy = self.model.score(X_test, y_test)
            
            logging.info(f"ML Model trained - Train accuracy: {train_accuracy:.2%}, Test accuracy: {test_accuracy:.2%}")
            
            self.is_trained = True
            return True
            
        except Exception as e:
            logging.error(f"Error training ML model: {e}")
            return False
    
    def predict_price_movement(self, stock_data: dict) -> Dict[str, float]:
        """
        🔮 Predict price movement direction and confidence
        
        Returns:
            Dict with:
            - prediction: 1 (UP), 0 (NEUTRAL), -1 (DOWN)
            - confidence: 0-100 probability score
            - ml_signal: BUY/HOLD/SELL
            - expected_return: Estimated % return
        """
        try:
            # Prepare features
            features = self.prepare_features(stock_data)
            
            if features is None:
                return self._get_fallback_prediction(stock_data)
            
            # If model not trained, use rule-based fallback
            if not self.is_trained or self.model is None:
                return self._get_fallback_prediction(stock_data)
            
            # Scale features
            features_scaled = self.scaler.transform(features.reshape(1, -1))
            
            # Predict
            prediction = self.model.predict(features_scaled)[0]
            probabilities = self.model.predict_proba(features_scaled)[0]
            
            # Get confidence (max probability)
            confidence = float(max(probabilities) * 100)
            
            # Map prediction to signal
            if prediction == 1:
                ml_signal = "BUY"
                expected_return = confidence * 0.15  # Scale confidence to expected return
            elif prediction == -1:
                ml_signal = "SELL"
                expected_return = -confidence * 0.10
            else:
                ml_signal = "HOLD"
                expected_return = 0.0
            
            return {
                'ml_prediction': int(prediction),
                'ml_confidence': confidence,
                'ml_signal': ml_signal,
                'ml_expected_return': expected_return,
                'ml_probabilities': {
                    'up': float(probabilities[2]) * 100 if len(probabilities) > 2 else 0,  # Class 1 (UP)
                    'neutral': float(probabilities[1]) * 100 if len(probabilities) > 1 else 0,  # Class 0
                    'down': float(probabilities[0]) * 100  # Class -1 (DOWN)
                }
            }
            
        except Exception as e:
            logging.error(f"Error in ML prediction: {e}")
            return self._get_fallback_prediction(stock_data)
    
    def _get_fallback_prediction(self, stock_data: dict) -> Dict[str, float]:
        """
        🔄 Rule-based fallback when ML model unavailable
        Uses technical and momentum indicators
        """
        try:
            # Collect indicators
            rsi = stock_data.get('real_rsi', 50)
            macd = stock_data.get('enhanced_macd', 0)
            price_change_5d = stock_data.get('enhanced_price_change_5d', 0)
            momentum_score = stock_data.get('momentum_score', 0)
            volume_ratio = stock_data.get('enhanced_volume_ratio', 1)
            
            # Calculate score
            score = 0
            
            # RSI signals
            if rsi < 30:
                score += 2  # Oversold - bullish
            elif rsi > 70:
                score -= 2  # Overbought - bearish
            elif 40 <= rsi <= 60:
                score += 0.5  # Neutral zone
            
            # MACD signals
            if macd > 0:
                score += 1
            else:
                score -= 1
            
            # Price momentum
            if price_change_5d > 3:
                score += 1.5
            elif price_change_5d < -3:
                score -= 1.5
            
            # Momentum score
            if momentum_score >= 70:
                score += 2
            elif momentum_score <= 30:
                score -= 1
            
            # Volume confirmation
            if volume_ratio > 1.5:
                score *= 1.2  # Amplify signal with volume
            
            # Map score to prediction
            if score >= 2:
                prediction = 1
                ml_signal = "BUY"
                confidence = min(abs(score) * 15, 75)
            elif score <= -2:
                prediction = -1
                ml_signal = "SELL"
                confidence = min(abs(score) * 15, 75)
            else:
                prediction = 0
                ml_signal = "HOLD"
                confidence = 50
            
            return {
                'ml_prediction': prediction,
                'ml_confidence': confidence,
                'ml_signal': ml_signal,
                'ml_expected_return': prediction * confidence * 0.1,
                'ml_probabilities': {
                    'up': confidence if prediction == 1 else (100 - confidence) / 2,
                    'neutral': 50 if prediction == 0 else 25,
                    'down': confidence if prediction == -1 else (100 - confidence) / 2
                },
                'ml_mode': 'FALLBACK_RULE_BASED'
            }
            
        except Exception as e:
            logging.error(f"Error in fallback prediction: {e}")
            return {
                'ml_prediction': 0,
                'ml_confidence': 50,
                'ml_signal': "HOLD",
                'ml_expected_return': 0,
                'ml_probabilities': {'up': 33, 'neutral': 34, 'down': 33},
                'ml_mode': 'ERROR_FALLBACK'
            }
    
    def get_feature_importance(self) -> Dict[str, float]:
        """📊 Get feature importance scores"""
        if self.is_trained and self.model is not None:
            try:
                importances = self.model.feature_importances_
                # Return top 20 most important features
                return dict(sorted(enumerate(importances), key=lambda x: x[1], reverse=True)[:20])
            except:
                pass
        return {}


# Singleton instance
_ml_predictor_instance = None

def get_ml_predictor() -> MLPricePredictor:
    """Get singleton ML predictor instance"""
    global _ml_predictor_instance
    if _ml_predictor_instance is None:
        _ml_predictor_instance = MLPricePredictor()
    return _ml_predictor_instance
