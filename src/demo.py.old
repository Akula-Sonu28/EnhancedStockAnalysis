# Demo Script: Run complete stock analysis
from stock_analyzer_dashboard import StockAnalyzerDashboard
import json
import logging
from config import LOG_FILE

logging.basicConfig(filename=LOG_FILE, level=logging.INFO, format="%(asctime)s %(levelname)s:%(message)s")

def run_analysis(symbol):
	np.random.seed(42)
	symbols = [f"DEMO{i+1}" for i in range(n)]
	sample_fundamentals = []
	sample_technicals = []
	for _ in range(n):
		info = {
			'trailingPE': np.random.uniform(10, 40),
			'priceToBook': np.random.uniform(1, 10),
			'enterpriseToRevenue': np.random.uniform(1, 5),
			'enterpriseToEbitda': np.random.uniform(5, 20),
			'priceToSalesTrailing12Months': np.random.uniform(1, 10),
			'returnOnEquity': np.random.uniform(0.05, 0.35),
			'returnOnAssets': np.random.uniform(0.02, 0.15),
			'grossMargins': np.random.uniform(0.2, 0.7),
			'operatingMargins': np.random.uniform(0.1, 0.4),
			'debtToEquity': np.random.uniform(0.1, 2),
			'currentRatio': np.random.uniform(1, 3),
			'quickRatio': np.random.uniform(0.8, 2.5),
			'interestCoverage': np.random.uniform(2, 15),
			'revenueGrowth': np.random.uniform(0.01, 0.25),
			'earningsGrowth': np.random.uniform(0.01, 0.25),
			'quarterlyRevenueGrowth': np.random.uniform(0.01, 0.25),
			'marketCap': np.random.randint(2000, 200000),
			'beta': np.random.uniform(0.7, 1.5),
			'sharesOutstanding': np.random.randint(10e6, 1e9),
			'floatShares': np.random.randint(10e6, 1e9),
			'dividendYield': np.random.uniform(0, 0.05),
			'payoutRatio': np.random.uniform(0.1, 0.7),
			'sector': np.random.choice(['IT', 'Finance', 'Energy', 'FMCG', 'Auto']),
			'industry': np.random.choice(['Software', 'Banking', 'Oil & Gas', 'Consumer', 'Automobile']),
			'longBusinessSummary': 'Sample summary',
			'assetTurnover': np.random.uniform(0.5, 2),
			'workingCapital': np.random.uniform(100, 10000),
			'cashRatio': np.random.uniform(0.1, 1.5),
			'totalCash': np.random.uniform(1e7, 1e9),
			'totalDebt': np.random.uniform(1e7, 1e9),
			'totalAssets': np.random.uniform(1e8, 1e10),
			'totalCurrentAssets': np.random.uniform(1e7, 1e9),
			'totalCurrentLiabilities': np.random.uniform(1e7, 1e9)
		}
		sample_fundamentals.append(info)
		# Simulate OHLCV for technicals
		close = np.cumsum(np.random.normal(0, 1, 250)) + 100
		high = close + np.random.uniform(0, 2, 250)
		low = close - np.random.uniform(0, 2, 250)
		open_ = close + np.random.uniform(-1, 1, 250)
		volume = np.random.randint(1e5, 1e6, 250)
		df = pd.DataFrame({'Open': open_, 'High': high, 'Low': low, 'Close': close, 'Volume': volume})
		sample_technicals.append(df)
	return symbols, sample_fundamentals, sample_technicals

def main():
	print("Running demo analysis with sample data...")
	symbols, fundamentals, technicals = generate_sample_data()
	results = []
	for symbol, fund, tech in zip(symbols, fundamentals, technicals):
		fund_metrics = extract_fundamental_metrics(fund)
		fund_score = compute_fundamental_score(fund_metrics)
		tech_ind = calculate_indicators(tech)
		tech_score = compute_technical_score(tech_ind)
		overall_score = round((fund_score + tech_score) / 2, 2)
		row = {"symbol": symbol, **fund_metrics, **tech_ind,
			   "FundamentalScore": fund_score, "TechnicalScore": tech_score, "OverallScore": overall_score}
		results.append(row)
	df = pd.DataFrame(results)
	print(df[['symbol', 'OverallScore']].sort_values('OverallScore', ascending=False).head(5))
	export_data(df)

if __name__ == "__main__":
	main()
