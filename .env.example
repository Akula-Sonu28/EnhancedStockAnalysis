# Copy to .env (gitignored). Never commit .env or paste secrets in chat.

# Zerodha Kite Connect — holdings sync (Personal app is enough)
KITE_API_KEY=replace_me
KITE_API_SECRET=replace_me
# Daily session (Personal app: browser login required; token expires ~6 AM IST)
#   python3 scripts/kite_login.py --check
#   python3 scripts/kite_login.py --auto   # needs Redirect URL http://127.0.0.1:8765/
KITE_ACCESS_TOKEN=
KITE_REFRESH_TOKEN=
KITE_USE_HOLDINGS=false
KITE_AUTO_LOGIN=false
KITE_REDIRECT_PORT=8765

# Upstox — market data only (OHLCV / LTP). No holdings or orders.
UPSTOX_ACCESS_TOKEN=
UPSTOX_DATA_ENABLED=false

# Groww — optional OHLCV backfill only
GROWW_API_KEY=replace_me
GROWW_API_SECRET=replace_me
